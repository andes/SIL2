//top.window.outerHeight = screen.availHeight;
//top.window.outerWidth = screen.availWidth;
//}
//}
         function  efecto(){
       $('#cargando').hide();
                             $('#contenidoWeb').fadeIn(500);                           
        }     
        
        
        function Salir()
        {
        window.close();
        }  
        
       function hoy()
{
   var fechaActual = new Date();
 
    dia = fechaActual.getDate();
    mes = fechaActual.getMonth() +1;
    anno = fechaActual.getYear();
    
 
    if (dia <10) dia = "0" + dia;
    if (mes <10) mes = "0" + mes;   
 
    fechaHoy = dia + "/" + mes + "/" + anno;
    
    return fechaHoy;
}
   </script>   
  <asp:ContentPlaceHolder ID="head" runat="server">
 
  
      <style type="text/css">


      
 
#menu {
    position: absolute;
    right: 0;
    top: 15px;
    display:none;
}
#nav {
    list-style: none;
    padding: 0;
    display: inline-block;
}
#nav.vertical {
    display: block;
    padding-left: 20px;
}
#nav.vertical li {
    display: list-item;
    line-height: 30px;
}
#nav li {
    display:inline-block;
    padding-right: 30px;
}
#nav li:last-child {
    padding-right: 0;
}
 h1 {
  color: #6c2eb9;
  font-weight: normal;
  font-size: 30px;
  font-family: Arial;
  text-transform: uppercase;
}

  </style>

  </asp:ContentPlaceHolder>

    <style type="text/css">
        
 .usuario-dropdown {
    position: relative;
    display: inline-block;
    text-align: left;
    font-family: Arial;
    text-transform: none;
    font-size: 14px;
    color: #333;
}

.usuario-dropdown summary {
    list-style: none;
    cursor: pointer;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 10px;
    background: #fff;
    min-width: 300px;
}

.usuario-dropdown summary::-webkit-details-marker {
    display: none;
}

.usuario-dropdown summary:hover {
    background-color: #f8f8f8;
}

.usuario-dropdown .usuario-titulo {
    display: inline-block;
    font-weight: bold;
}

.usuario-dropdown .usuario-flecha {
    float: right;
}

.usuario-dropdown .usuario-opciones {
    position: absolute;
    right: 0;
    top: 100%;
    width: 320px;
    margin: 0;
    padding: 5px 0;
    list-style: none;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 0 0 10px 10px;
    box-shadow: 0 4px 8px rgba(0,0,0,.10);
    z-index: 1000;
}

.usuario-dropdown .usuario-opciones li a {
    display: block;
    padding: 10px 14px;
    color: #333;
    text-decoration: none;
    font-weight: normal;
}

.usuario-dropdown .usuario-opciones li a:hover {
    background-color: #f5f5f5;
}

.usuario-dropdown .usuario-opciones li a .glyphicon {
    color: #666;
    margin-right: 8px;
    width: 15px;
}

.usuario-dropdown .usuario-separador {
    border-top: 1px solid #eee;
    margin: 5px 0;
}
    </style>
</head>
  


	
   


<body class="body" onload="Javascript:history.go(1);" onunload="Javascript:history.go(1);"> 	

		  <form runat="server" id="form1"> 
        <div >  
