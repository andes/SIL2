                     <i class="fa fa-user"></i>
                    &nbsp;   <asp:Label ID="lblUsuarioConectado" runat="server" ></asp:Label>
                </span>
                <span class="glyphicon glyphicon-chevron-down usuario-flecha"></span>
            </summary>

            <ul class="usuario-opciones">
                <li>
                    <asp:HyperLink
