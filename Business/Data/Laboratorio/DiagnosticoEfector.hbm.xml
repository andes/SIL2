    <many-to-one  name="IdDiagnostico"  column="idDiagnostico"  class="Business.Data.Cie10,Business"  />      
    <many-to-one name="IdUsuarioRegistro" column="idUsuarioRegistro" class="Business.Data.Usuario,Business" />   
